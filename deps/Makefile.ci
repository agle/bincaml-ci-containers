#k
# CI Docker images — included by top-level Makefile
CI_REGISTRY = ghcr.io/agle/bincaml-ci-containers
CI_VERSIONS = 5.4

# To update: curl -s https://api.github.com/repos/ocaml/opam-repository/commits/master | jq -r .sha
OPAM_REPO_COMMIT ?= 009959aa9bfb2ad1c1d252137957496b181f73a4
CI_BASE_OS_PACKAGES = gmp-dev ca-certificates curl git unzip alpine-sdk bash protobuf protobuf-dev capstone capstone-dev

CI_COMMON_PACKAGES = dune ptime sexplib zarith yojson mtime alcotest base ocamlgraph \
										 base logs lwt linol-lwt linol ppxlib \
										 ppx_enumerate ppx_expect ppx_hash ppx_here ppx_import ppx_deriving qcheck-stm qcheck \
										 trace trace-tef cppo either fix hector intPQueue jst-config jane-street-headers iter \
										 pp_loc qcheck-alcotest \
										 angstrom menhir ocaml-protoc-plugin aslp_lifter_ocaml kittyimg linenoise \
                                         patricia-tree  result store terminal_size



CI_EXTRA_OS_PACKAGES = tree-sitter-cli nodejs bash bnfc boogie cvc5 linux-headers diffutils

CI_PACKAGES_408 = $(CI_COMMON_PACKAGES)
CI_PACKAGES_414 = $(CI_COMMON_PACKAGES) ocamlformat.0.29.0
CI_PACKAGES_50  = $(CI_COMMON_PACKAGES)
CI_PACKAGES_53_DOC = $(CI_COMMON_PACKAGES) ocamlformat.0.29.0 odig odoc odoc-driver
CI_PACKAGES_54  = $(CI_COMMON_PACKAGES)

CI_BUILD = podman build -f deps/dockerfile.ocaml \
    --build-arg OPAM_REPO_COMMIT=$(OPAM_REPO_COMMIT) \
    --build-arg "BASE_OS_PACKAGES=$(CI_BASE_OS_PACKAGES)" \
    --build-arg "EXTRA_OS_PACKAGES=$(CI_EXTRA_OS_PACKAGES)"

build-ci-docker: build-5.3 build-5.4

build-4.08:
	$(CI_BUILD) --build-arg OCAML_VERSION=4.08.1 --build-arg "BASE_PACKAGES=$(CI_PACKAGES_408)" -t $(CI_REGISTRY)/ci-4.08:latest .

build-4.14:
	$(CI_BUILD) --build-arg OCAML_VERSION=4.14.2 --build-arg "BASE_PACKAGES=$(CI_PACKAGES_414)" -t $(CI_REGISTRY)/ci-4.14:latest .

build-5.0:
	$(CI_BUILD) --build-arg OCAML_VERSION=5.0.0  --build-arg "BASE_PACKAGES=$(CI_PACKAGES_50)"     -t $(CI_REGISTRY)/ci-5.0:latest .

build-5.3:
	$(CI_BUILD) --build-arg OCAML_VERSION=5.3.0 --build-arg "KEEP_DOC=KEEP_DOC" --build-arg "BASE_PACKAGES=$(CI_PACKAGES_53_DOC)" -t $(CI_REGISTRY)/ci-doc-5.3:latest .

build-5.4:
	$(CI_BUILD) --build-arg OCAML_VERSION=5.4.1  --build-arg "BASE_PACKAGES=$(CI_PACKAGES_54)"  -t $(CI_REGISTRY)/ci-5.4:latest .


upload-ci:
	@for v in $(CI_VERSIONS); do \
		podman push $(CI_REGISTRY)/ci-$$v:latest ; \
	done && \
	podman push $(CI_REGISTRY)/ci-doc-5.3:latest
